// TRÍ AI SALES ROBOT - Enterprise & SaaS Data Layer
// PostgreSQL + pgvector Schema definition

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

// -----------------------------------------------------------------------------
// 1. RBAC & IDENTITY
// -----------------------------------------------------------------------------
model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password_hash")
  fullName      String         @map("full_name")
  role          String         @default("customer")
  plan          String         @default("Free")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  userRoles     UserRole[]
  conversations Conversation[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Role {
  id          String         @id @default(uuid())
  name        String         @unique
  description String?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  userRoles   UserRole[]

  @@map("roles")
}

model Permission {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  module    String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// -----------------------------------------------------------------------------
// 2. ROBOT PROFILE
// -----------------------------------------------------------------------------
model RobotProfile {
  id           String   @id @default(uuid())
  name         String   @default("TRÍ AI SALES ROBOT")
  modelType    String   @default("cyber_valkyrie") @map("model_type")
  avatarUrl    String?  @map("avatar_url")
  tone         String   @default("Chuyên nghiệp, thân thiện, lịch thiệp")
  greeting     String?
  systemPrompt String?  @map("system_prompt")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("robot_profiles")
}

// -----------------------------------------------------------------------------
// 3. PRODUCT CATALOG
// -----------------------------------------------------------------------------
model ProductCategory {
  id        String            @id @default(uuid())
  parentId  String?           @map("parent_id")
  name      String
  slug      String            @unique
  icon      String?
  sortOrder Int               @default(0) @map("sort_order")
  isActive  Boolean           @default(true) @map("is_active")
  createdAt DateTime          @default(now()) @map("created_at")

  parent    ProductCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryHierarchy")

  @@map("product_categories")
}

model Product {
  id             String             @id @default(uuid())
  field          String
  groupName      String             @map("group_name")
  name           String
  slug           String             @unique
  sku            String?
  price          Int
  priceFormatted String?            @map("price_formatted")
  specsJson      String?            @map("specs_json")
  description    String?
  imageUrl       String?            @map("image_url")
  isApproved     Boolean            @default(true) @map("is_approved")
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  images         ProductImage[]
  attributes     ProductAttribute[]
  prices         ProductPrice[]
  inventory      InventoryRecord?
  leads          Lead[]

  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  imageUrl  String   @map("image_url")
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  attrName  String   @map("attr_name")
  attrValue String   @map("attr_value")
  createdAt DateTime @default(now()) @map("created_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_attributes")
}

model ProductPrice {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  price         Int
  effectiveDate DateTime @map("effective_date")
  approvedBy    String?  @map("approved_by")
  note          String?
  createdAt     DateTime @default(now()) @map("created_at")

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_prices")
}

model InventoryRecord {
  id            String   @id @default(uuid())
  productId     String   @unique @map("product_id")
  stockQuantity Int      @default(0) @map("stock_quantity")
  warehouseLoc  String?  @map("warehouse_location")
  lastCheckedAt DateTime? @map("last_checked_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("inventory_records")
}

// -----------------------------------------------------------------------------
// 4. RAG KNOWLEDGE BASE & EMBEDDINGS (pgvector)
// -----------------------------------------------------------------------------
model KnowledgeDocument {
  id            String             @id @default(uuid())
  title         String
  fileType      String             @map("file_type")
  filePath      String?            @map("file_path")
  fileSize      Int?               @map("file_size")
  sourceType    String             @default("manual_upload") @map("source_type")
  status        String             @default("approved")
  extractedText String?            @map("extracted_text")
  version       Int                @default(1)
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  chunks        KnowledgeChunk[]
  versions      KnowledgeVersion[]

  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id           String               @id @default(uuid())
  documentId   String               @map("document_id")
  chunkIndex   Int                  @map("chunk_index")
  content      String
  charCount    Int?                 @map("char_count")
  embeddingJson String?             @map("embedding_json")
  metadataJson String?              @map("metadata_json")
  createdAt    DateTime             @default(now()) @map("created_at")

  document     KnowledgeDocument    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  embeddings   KnowledgeEmbedding[]

  @@map("knowledge_chunks")
}

model KnowledgeEmbedding {
  id         String                                  @id @default(uuid())
  chunkId    String                                  @map("chunk_id")
  model      String                                  @default("text-embedding-3-small")
  vectorJson String                                  @map("vector_json")
  dimensions Int                                     @default(1536)
  createdAt  DateTime                                @default(now()) @map("created_at")

  chunk      KnowledgeChunk                          @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@map("knowledge_embeddings")
}

model KnowledgeSource {
  id           String    @id @default(uuid())
  name         String
  sourceUrl    String?   @map("source_url")
  sourceType   String    @map("source_type")
  isApproved   Boolean   @default(true) @map("is_approved")
  syncSchedule String?   @map("sync_schedule")
  lastSyncedAt DateTime? @map("last_synced_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("knowledge_sources")
}

model KnowledgeVersion {
  id            String            @id @default(uuid())
  documentId    String            @map("document_id")
  versionNumber Int               @map("version_number")
  changeSummary String?           @map("change_summary")
  approvedBy    String?           @map("approved_by")
  createdAt     DateTime          @default(now()) @map("created_at")

  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("knowledge_versions")
}

// -----------------------------------------------------------------------------
// 5. FAQ, SCENARIOS & RULES
// -----------------------------------------------------------------------------
model FaqItem {
  id         String   @id @default(uuid())
  category   String?
  question   String
  answer     String
  tagsJson   String?  @map("tags_json")
  usageCount Int      @default(0) @map("usage_count")
  isApproved Boolean  @default(true) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("faq_items")
}

model SalesScenario {
  id             String   @id @default(uuid())
  scenarioName   String   @map("scenario_name")
  customerIntent String   @map("customer_intent")
  suggestedAction String  @map("suggested_action")
  scriptTemplate String   @map("script_template")
  priority       Int      @default(1)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("sales_scenarios")
}

model AiRule {
  id               String   @id @default(uuid())
  ruleCode         String   @unique @map("rule_code")
  ruleType         String   @map("rule_type")
  description      String
  enforcementLevel String   @default("strict") @map("enforcement_level")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("ai_rules")
}

// -----------------------------------------------------------------------------
// 6. CONVERSATIONS & CRM LEADS
// -----------------------------------------------------------------------------
model Conversation {
  id            String                @id @default(uuid())
  userId        String                @default("usr_anonymous") @map("user_id")
  agentId       String?               @default("tri-ai-sales-robot") @map("agent_id")
  skillId       String?               @default("chatbot-sales-ai") @map("skill_id")
  title         String                @default("Phiên tư vấn bán hàng")
  isArchived    Boolean               @default(false) @map("is_archived")
  lastMessageAt DateTime?             @map("last_message_at")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id])
  messages      ConversationMessage[]
  leads         Lead[]

  @@map("conversations")
}

model ConversationMessage {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  senderType     String       @map("sender_type")
  senderId       String?      @map("sender_id")
  content        String
  metadataJson   String?      @map("metadata_json")
  createdAt      DateTime     @default(now()) @map("created_at")

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("conversation_messages")
}

model Lead {
  id                  String         @id @default(uuid())
  customerName        String         @map("customer_name")
  phone               String
  email               String?
  productId           String?        @map("product_id")
  productName         String?        @map("product_name")
  quantity            Int            @default(1)
  customerRequirement String?        @map("customer_requirement")
  conversationId      String?        @map("conversation_id")
  websiteSource       String         @default("TRÍ AI Humanoid Widget") @map("website_source")
  widgetId            String         @default("WIDGET_HUMANOID_V1") @map("widget_id")
  consentToContact    Boolean        @default(true) @map("consent_to_contact")
  createdTime         DateTime       @default(now()) @map("created_time")
  leadStatus          String         @default("NEW – WAITING FOR OWNER CONTACT") @map("lead_status")
  notes               String?
  updatedAt           DateTime       @updatedAt @map("updated_at")

  conversation        Conversation?  @relation(fields: [conversationId], references: [id])
  product             Product?       @relation(fields: [productId], references: [id])
  activities          LeadActivity[]

  @@index([phone])
  @@index([leadStatus])
  @@map("leads")
}

model LeadActivity {
  id           String   @id @default(uuid())
  leadId       String   @map("lead_id")
  activityType String   @map("activity_type")
  performedBy  String   @map("performed_by")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("lead_activities")
}

// -----------------------------------------------------------------------------
// 7. TESTING, SYSTEM & AUDIT
// -----------------------------------------------------------------------------
model Notification {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String   @default("info")
  isRead    Boolean  @default(false) @map("is_read")
  actionUrl String?  @map("action_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("notifications")
}

model UnansweredQuestion {
  id             String    @id @default(uuid())
  conversationId String?   @map("conversation_id")
  question       String
  contextJson    String?   @map("context_json")
  status         String    @default("pending")
  resolvedAnswer String?   @map("resolved_answer")
  resolvedBy     String?   @map("resolved_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  @@map("unanswered_questions")
}

model AiTestCase {
  id                String         @id @default(uuid())
  category          String
  testName          String         @map("test_name")
  inputPrompt       String         @map("input_prompt")
  expectedBehavior  String         @map("expected_behavior")
  forbiddenKeywords String?        @map("forbidden_keywords")
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at")

  results           AiTestResult[]

  @@map("ai_test_cases")
}

model AiTestResult {
  id              String     @id @default(uuid())
  testCaseId      String     @map("test_case_id")
  modelUsed       String     @map("model_used")
  aiOutput        String     @map("ai_output")
  passed          Boolean
  score           Float?
  evaluatedAt     DateTime   @default(now()) @map("evaluated_at")
  evaluationNotes String?    @map("evaluation_notes")

  testCase        AiTestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@map("ai_test_results")
}

model SystemSetting {
  id          String   @id @default(uuid())
  category    String   @default("general")
  key         String   @unique
  value       String
  isSecret    Boolean  @default(false) @map("is_secret")
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String
  targetEntity String   @map("target_entity")
  targetId     String?  @map("target_id")
  changesJson  String?  @map("changes_json")
  ipAddress    String?  @map("ip_address")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model EmailLog {
  id             String   @id @default(uuid())
  recipient      String
  subject        String
  contentSnippet String?  @map("content_snippet")
  status         String
  errorMessage   String?  @map("error_message")
  sentAt         DateTime @default(now()) @map("sent_at")

  @@map("email_logs")
}

model AgentSession {
  id           String   @id @default(uuid())
  agentId      String   @map("agent_id")
  sessionToken String   @unique @map("session_token")
  startedAt    DateTime @default(now()) @map("started_at")
  lastActiveAt DateTime @map("last_active_at")
  expiresAt    DateTime @map("expires_at")

  @@map("agent_sessions")
}
